# Copy this file to .env and fill in your key. .env is gitignored.
# All models are accessed via OpenRouter (https://openrouter.ai), which exposes
# every provider behind one OpenAI-compatible endpoint.
OPENROUTER_API_KEY=

# Optional: OpenRouter recommends these headers for usage attribution.
OPENROUTER_HTTP_REFERER=https://github.com/your-org/syco100
OPENROUTER_X_TITLE=syco100
